<Project Sdk="Aspire.AppHost.Sdk/13.6.5">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Cratis.AuthProxy.Composition</RootNamespace>
    <UserSecretsId>9f60d479-1589-4c32-b49a-075cfd3f6149</UserSecretsId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Aspire 13.6 warns (ASPIRE010) when the AppHost does not use the Aspire CLI bundle; the features that need the
         CLI bundle are not used by this AppHost, so suppress rather than take a dependency on the bundle. -->
    <NoWarn>$(NoWarn);CS1591;MA0048;ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AuthProxy/AuthProxy.csproj" />
    <ProjectReference Include="../Aspire/Aspire.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="../TestApp/TestApp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.NodeJs" />
  </ItemGroup>

</Project>
