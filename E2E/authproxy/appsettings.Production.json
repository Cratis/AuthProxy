{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Cratis": "Debug"
        }
    },
    "Cratis": {
        "AuthProxy": {
            "Profile": "LocalDevelopment",
            "Tenants": {
                "4f1d2c1e-6f1b-4d3b-9a46-5e2f2a7a2b10": {
                    "Name": "E2E tenant",
                    "SourceIdentifiers": ["4f1d2c1e-6f1b-4d3b-9a46-5e2f2a7a2b10"]
                }
            },
            "TenantResolutions": [
                { "Strategy": "Claim", "Options": { "ClaimType": "cratis/tenant" } }
            ],
            "Services": {
                "arc": {
                    "Default": true,
                    "Backend": { "BaseUrl": "http://arc:8080/" },
                    "Frontend": { "BaseUrl": "http://arc:8080/" },
                    "ResolveIdentityDetails": false,
                    "IdentityVerification": "BestEffort",
                    "ClientCredentials": { "RoutePrefix": "/.cratis" }
                },
                "grants": {
                    "Hosts": ["grant.local"],
                    "Backend": { "BaseUrl": "http://receiver:8080/" },
                    "ResolveIdentityDetails": false,
                    "IdentityVerification": "BestEffort",
                    "ForwardedIdentity": {
                        "Version": "v2",
                        "Audience": "grant-receiver",
                        "KeyId": "runtime-key"
                    },
                    "BearerRoutes": [
                        {
                            "PathPrefix": "/grants",
                            "TenantClaimType": "cratis/tenant",
                            "Audiences": ["grant-api"],
                            "RequiredScopes": ["grants.read"],
                            "ForwardAuthorizationHeader": true,
                            "AcceptWithoutIdentityVerification": true,
                            "Issuers": [{
                                "Issuer": "https://issuer:8443",
                                "Introspection": {
                                    "Endpoint": "https://issuer:8443/introspect",
                                    "ClientId": "e2e-introspection",
                                    "CacheDuration": "00:00:02"
                                }
                            }]
                        },
                        {
                            "PathPrefix": "/mcp",
                            "TenantClaimType": "cratis/tenant",
                            "ResourceMetadataUrl": "https://grant.local/.well-known/oauth-protected-resource/mcp",
                            "Audiences": ["grant-api"],
                            "RequiredScopes": ["grants.read"],
                            "ForwardAuthorizationHeader": true,
                            "AcceptWithoutIdentityVerification": true,
                            "Issuers": [{
                                "Issuer": "https://issuer:8443",
                                "Introspection": {
                                    "Endpoint": "https://issuer:8443/introspect",
                                    "ClientId": "e2e-introspection",
                                    "CacheDuration": "00:00:02"
                                }
                            }]
                        }
                    ]
                }
            }
        }
    }
}
